#!name=SubStore
#!desc=查看目标节点的入口落地详细信息
#!icon=https://github.com/Toovooo/Rules/raw/master/Icon/Color/SubStore.png
#!date=2026.11.16

[Argument]
cron=input, "55 23 * * *", tag=定时参数, desc=这里需要输入符合CRON表达式的参数
sync_success_notify=switch, true, tag=同步成功通知, desc=同步配置全部成功时是否发送完成通知
cors=input, "https://sub-store.vercel.app,http://substore.stash,https://substore.stash,https://sub.xream.eu.org", tag=CORS允许来源, desc=允许浏览器跨域访问 Sub-Store 后端的 origin. 多个用 , 连接. 设为 * 可恢复旧行为

[Rule]
DOMAIN,sub.xream.eu.org,PROXY
DOMAIN,sub-store.vercel.app,PROXY

[Script]
http-request ^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))) script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js, requires-body=true,max-size=-1, timeout=900, tag=Sub-Store Core, argument=[{cors}]
http-request ^https?:\/\/sub\.store script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js, requires-body=true,max-size=-1, timeout=900, tag=Sub-Store Simple, argument=[{cors}]

cron {cron} script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js, timeout=900, tag=Sub-Store Sync, argument=[{sync_success_notify},{cors}]



request if ${url} ~= /^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info)))/i then script("https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js", {${cors}}) with tag="Sub-Store Core", timeout=900, requires_body=true

request if ${url} ~= /^https?:\/\/sub\.store/i then script("https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js", {${cors}}) with tag="Sub-Store Simple", timeout=900, requires_body=true

cron ${cron} then script("https://github.com/sub-store-org/Sub-Store/releases/latest/download/cron-sync-artifacts.min.js", {${sync_success_notify}, ${cors}}) with tag="Sub-Store Sync", timeout=900

[MITM]
hostname=sub.store
