#!name=BoxJs
#!desc=数据管理
#!icon=https://github.com/Toovooo/Rules/raw/master/Icon/zo/BoxJS.png
#!date=2026.10.08

[Rule]
DOMAIN-SUFFIX,jsdelivr.net,PROXY

[Script]
request if ${url} ~= /^https?:\/\/(.+\.)?boxjs\.(com|net)/i then script("https://github.com/Toovooo/Rules/raw/master/Script/boxjs.js") with tag="BoxJS", timeout=120, requires_body=true

[Mitm]
hostname = boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net