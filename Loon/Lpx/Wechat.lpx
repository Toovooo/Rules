#!name=微信
#!desc=去公众号广告,解锁外链
#!icon=https://github.com/Toovooo/Rules/raw/master/Icon/zo/Weixin.png
#!date=2026.10.08

[Rule]
DOMAIN-SUFFIX, wxs.qq.com, REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword/i then reject_dict(200)

[Script]
response if ${url} ~= /^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?/i then script("https://github.com/Toovooo/Rules/raw/master/Script/WeChat/UnblockURLinWeChat.js") with tag="微信外部链接解锁", requires_body=true

[MitM]
hostname=mp.weixin.qq.com, weixin110.qq.com, security.wechat.com
