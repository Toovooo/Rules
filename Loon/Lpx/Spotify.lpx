#!name=Spotify
#!desc=去广告
#!icon=https://github.com/Toovooo/Rules/raw/master/Icon/zo/Spotify.png
#!date=2026.10.08

[Argument]
tab=switch, true, tag=移除底栏创建按钮, desc=此开关控制是否移除底栏创建按钮
useractivity=switch, true, tag=启用Apple设备接力, desc=此开关控制是否使用Apple设备接力

[Rule]
AND, ((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)), REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone/i as urlMatch then url.replace("https://spclient.wg.spotify.com/artistview/v1/artist/${urlMatch.1}&platform=ipad")

[Script]
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Spotify/Spotify.js", {${tab}, ${useractivity}}) with tag="Spotify", timeout=5, requires_body=true, binary_body_mode=true

[MitM]
hostname= *-spclient.spotify.com, spclient.wg.spotify.com