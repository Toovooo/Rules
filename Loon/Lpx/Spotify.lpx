#!name=Spotify
#!desc=去广告
#!icon=https://github.com/Toovooo/Rules/raw/master/Icon/zo/Spotify.png
#!date=2026.10.08

[Argument]
spot_remote_config = switch,false,tag=Remote config modification,desc=Alternative protobuf patch of the bootstrap/customize responses. When off (recommended) the local config override is used. Only one of the two runs, never both
hide_discovery_feed = switch,true,tag=Hide discovery feed,desc=Hides the discovery feed shown on the Now Playing screen
hide_membership_info = switch,true,tag=Hide membership info,desc=Hides the membership info in Settings (display only)
hide_ai_dj = switch,true,tag=Hide AI DJ,desc=Blocks the AI DJ entry so it does not appear in the app

[Rule]
AND,((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del if-none-match
request if ${url} ~= /^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon reject-dict
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[\w-]+-spclient)\.spotify\.com(?::443)?\/watch-feed-entrypoints\/v\d\/discovery-from-seed/ && ${hide_discovery_feed} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/[\w-]+-spclient\.spotify\.com(?::443)?\/pam-view-service\// && ${hide_membership_info} == true then reject_dict(200)
request if ${url} ~= /37i9dQZF1EYkqdzj48dyYq/ && ${hide_ai_dj} == true then reject_dict(200)

[Script]
request if ${url} ~= /^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service then script("https://github.com/Toovooo/Rules/raw/master/Script/Spotify/spot-gabo.js") with tag="Spotify gabo", timeout=10
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse then script("https://github.com/Toovooo/Rules/raw/master/Script/Spotify/spot-NoSearchAd.js") with tag="Spotify search ads", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/ then script("https://github.com/Toovooo/Rules/raw/master/Script/Spotify/spot-NoHomeAd.js") with tag="Spotify home ads", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify then script("https://github.com/Toovooo/Rules/raw/master/Script/Spotify/spot-NoScrollAd.js") with tag="Spotify scroll ads", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$ then script("https://github.com/Toovooo/Rules/raw/master/Script/Spotify/spot-proto-eevee.js") with enable=${spot-ev1-enable}, tag="Spotify protobuf (remote)", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$ then script("https://github.com/Toovooo/Rules/raw/master/Script/Spotify/spot-proto-ev3.js") with enable=${spot-ev3-enable}, tag="Spotify protobuf (local)", timeout=10, requires_body=true, binary_body_mode=true

[Mitm]
hostname = spclient.wg.spotify.com, *spclient.spotify.com
