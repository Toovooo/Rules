#!name=YouTube
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。
#!icon=https://github.com/Toovooo/Rules/raw/master/Icon/zo/YouTube.png
#!date=2026.10.08

[Argument]
background_playback = switch,false,tag=后台播放,desc=切换应用或锁定屏幕，仍可继续播放常规视频的音频
playback_region = select,"original","CN","HK","TW","US","JP","KR","SG","GB","DE","RU",tag=请求播放区域,desc=保持当前区域不变。仅更改客户端的 GL 参数，出口 IP 保持不变
translation_enabled = switch,false,tag=字幕翻译,desc=将现有字幕翻译为所选目标语言。若关闭此功能，则保留原始字幕请求
translation_target = select,"zh-CN","en-US",tag=字幕目标语言,desc=仅支持转换现有的字幕轨道，无字幕的视频无法进行翻译
hide_home_shorts = switch,false,tag=隐藏主页短视频,desc=从首页信息流中移除“Shorts”版块。其他页面保持不变；底部“Shorts”标签页设有独立的开关
hide_shorts_tab = switch,false,tag=隐藏Shorts按钮,desc=移除应用底部栏中的“Shorts”按钮
hide_create_button = switch,false,tag=隐藏上传按钮,desc=移除了应用底部栏上的“创建”（+）按钮
blocked_channels = input,"",tag=黑名单,desc=输入频道 ID、@用户名或完整频道名称，以空格分隔。建议优先使用频道 ID；若名称中包含空格，请使用用户名或 ID。留空即表示禁用。仅隐藏那些所有者可被识别的视频。
blocked_channels_url = input,"",tag=远程屏蔽频道 URL,desc=Public HTTPS plain-text direct link (e.g. GitHub Raw). Local cache refreshes hourly when the scheduled update is on. To refresh now, with the scheduled update on, run its script manually from the plugin script list. Merged with the manual list. Leave empty to disable
blocked_channels_update = switch,false,tag=Blocked channels scheduled update,desc=Refreshes the remote blocked channels list every hour. Only needed with a remote list URL: when off, the hourly task is disabled and cannot be run manually either, so the cached list stays as it is
log_enabled = switch,false,tag=Logging tool,desc=Starts automatically on the first matched request and notifies the log entry point. When turned off, the next API hit clears the log and stops sampling, download it first if you need it. Full sampling may add delay
quality_research = switch,false,tag=Quality research sampling,desc=Only active when the logging tool is on. Records recognizable quality and format parameters and reads small media POST requests for comparison. Does not switch quality automatically
media_capture_mode = select,"headers","full",tag=Media sampling mode,desc=Only active when the logging tool is on, disabled automatically when logging is off. headers records response headers only. full reads the whole response for development and may add delay
log_level = select,"info","debug","warn","error",tag=Log level,desc=info keeps the full redacted trace. error keeps errors only. debug keeps debug level. warn keeps warnings and errors
capture_budget = select,"32","16","64",tag=Log capacity (MB),desc=Recording stops when the limit is reached, existing samples are kept. Clear after exporting

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${request.header['User-Agent']} ~= /(?:^|\s)com\.google\.ios\.youtube\//i then reject_video(200)
response if ${url} ~= /^https:\/\/(?:[\w-]+\.)*googlevideo\.com(?::443)?\//i then response.header.set("Alt-Svc", "clear")

[Script]
cron "0 * * * *" then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/request.min.js", {${blocked_channels_url}}) with enable=${blocked_channels_update}, tag="YouTube scheduled blocked channels update", timeout=10
request if ${url} ~= /^https:\/\/(?:www\.|m\.)?youtube\.com\/api\/timedtext\?[^#]+$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/request.min.js", {${translation_enabled}, ${translation_target}}) with enable=${translation_enabled}, tag="YouTube subtitle target language", timeout=10
request if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${log_enabled} == true && ${quality_research} == true then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${quality_research}}) with tag="YouTube quality research request sampling", timeout=10, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:browse|next|search|reel\/reel_watch_sequence)(?:\?[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/videoplayback\?[^#]*$|^http:\/\/youtube-logs\.invalid(?::80)?(?:\/[^#]*)?$|^https:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${background_playback}, ${media_capture_mode}, ${quality_research}}) with enable=${log_enabled}, tag="YouTube logging and export", timeout=10
request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${playback_region}}) with tag="YouTube config request handling", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$/i && ${log_enabled} == true && ${media_capture_mode} == "full" then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${media_capture_mode}}) with tag="YouTube full media development sampling", timeout=30, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/[\w-]+\.googlevideo\.com\/(?:videoplayback|initplayback)(?:\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}}) with enable=${log_enabled}, tag="YouTube media response logging", timeout=10
response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}}) with tag="YouTube Onesie config cache", timeout=10, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/request.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${playback_region}}) with tag="YouTube playback request and ad config handling", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.)?youtube\.com)\/youtubei\/v1\/guide(?:\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${hide_shorts_tab}, ${hide_create_button}}) with tag="YouTube bottom bar Shorts tab and Create button", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(browse|next|search)(\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${hide_home_shorts}, ${blocked_channels}, ${blocked_channels_url}}) with tag="YouTube feed ads and Home Shorts handling", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/(player|get_watch)(\?[^#]*)?$|^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www\.|m\.|music\.)?youtube\.com)\/youtubei\/v1\/reel\/reel_watch_sequence(?:\?[^#]*)?$/i then script("https://github.com/Toovooo/Rules/raw/master/Script/Youtube/response.min.js", {${log_enabled}, ${log_level}, ${capture_budget}, ${background_playback}, ${quality_research}}) with tag="YouTube playback response and background playback", timeout=10, requires_body=true, binary_body_mode=true

[Mitm]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, youtube.com, www.youtube.com, m.youtube.com, music.youtube.com, *.googlevideo.com
